# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，不会提交
MYSQL_ROOT_PASSWORD=replace_with_your_root_password
MYSQL_PASSWORD=replace_with_your_serviceflow_password
MYSQL_DATABASE=serviceflow
MYSQL_USER=serviceflow
MYSQL_PORT=3306
MYSQL_HOST=127.0.0.1

# Java 后端（容器内使用服务名 mysql / ai，而不是 127.0.0.1）
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
# 至少 32 字节的随机串，禁止使用示例值
JWT_SECRET=replace_with_a_random_32byte_secret
JWT_EXPIRE_MINUTES=120
ADMIN_INITIAL_PASSWORD=replace_with_your_admin_password
# 会话 Cookie 是否仅 HTTPS 传输：启用 HTTPS 后必须 true；纯 HTTP 过渡期显式设为 false
COOKIE_SECURE=true

# Python AI 服务：密钥只注入 ai 容器
DEEPSEEK_API_KEY=replace_with_your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
# 治理路由启用后由 Java 在请求内下发供应商参数，允许 Python 进程没有 DEEPSEEK_API_KEY
AI_ALLOW_PROVIDER_OVERRIDE=true

# AI 治理
# 供应商密钥加密主密钥：base64 编码的 32 字节，生成命令 openssl rand -base64 32
# 未配置时无法保存供应商密钥，AI 调用继续使用上面的 DEEPSEEK_* 配置
AI_SECRET_KEY=
# 超级管理员白名单（用户名，逗号分隔）；留空表示所有 ADMIN 均可管理供应商与密钥
SUPER_ADMIN_USERNAMES=

# 前端端口与监听地址：本机默认仅 127.0.0.1；云服务器改为 0.0.0.0 并在安全组放行对应端口
FRONTEND_PORT=8085
FRONTEND_BIND=127.0.0.1
