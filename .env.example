# ServiceFlow AI 环境变量示例（本地直接启动时参考）
# 说明：
#   1. 本文件只含占位符，不含任何真实密码或密钥；复制为 .env 后填写，.env 已被 .gitignore 忽略。
#   2. Spring Boot 不会自动读取 .env，本地启动前请在终端 export/设置同名环境变量；
#      Docker Compose 会自动读取 deploy/.env。
#   3. 若这些凭据曾出现在聊天记录、提交历史或日志中，请立即轮换。

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=serviceflow
MYSQL_USER=serviceflow
MYSQL_PASSWORD=replace_with_your_db_password
MYSQL_ROOT_PASSWORD=replace_with_your_root_password

# ---------- Java 后端 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# JWT 密钥：至少 32 字节的随机串，禁止使用示例值上线
JWT_SECRET=replace_with_a_random_32byte_secret
JWT_EXPIRE_MINUTES=120
# SLA 策略（可选，缺省 4/8/24/72 小时、120 分钟预警）
SLA_WARNING_MINUTES=120
SLA_URGENT_HOURS=4
SLA_HIGH_HOURS=8
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=72

# ---------- Python AI 服务 ----------
# 模型密钥只给 Python 服务，绝不注入前端或提交到仓库
DEEPSEEK_API_KEY=replace_with_your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
AI_RATE_LIMIT_PER_MINUTE=12
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
AI_SERVICE_CONNECT_TIMEOUT_MS=3000
AI_SERVICE_READ_TIMEOUT_MS=90000
# 治理路由启用后由 Java 在请求内下发供应商参数
AI_ALLOW_PROVIDER_OVERRIDE=true

# ---------- AI 治理 ----------
# 供应商密钥加密主密钥（base64 32 字节），生成：openssl rand -base64 32
AI_SECRET_KEY=
# 超级管理员白名单（用户名，逗号分隔）；留空表示所有 ADMIN 均可管理供应商与密钥
SUPER_ADMIN_USERNAMES=

# ---------- 前端（构建期） ----------
# 留空表示同源（开发走 Vite 代理，生产走 nginx 反代）
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8080
