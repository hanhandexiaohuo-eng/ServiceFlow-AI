# 真实环境变量文件（含密码），绝不提交
.env
.env.*
!.env.example
# 前端构建期环境文件只含非敏感配置，需要纳入版本管理
!frontend/.env.development
!frontend/.env.production

# Node / 前端
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Java / Maven
backend-java/target/
*.jar
!backend-java/.mvn/wrapper/maven-wrapper.jar

# Python
ai-python/.venv/
__pycache__/
*.pyc

# IDE
.idea/
.vscode/
*.iml

# 日志与本地工具
*.log
*.log.*
backend-java/logs/
.tools/

# Trae IDE 本地配置（spec、规则等，不随仓库分发）
.trae/
